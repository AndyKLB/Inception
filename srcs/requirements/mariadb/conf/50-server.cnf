[mysqld]
skip-grant-tables=0
user                    = mysql
pid-file                = /run/mysqld/mysqld.pid
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp

bind-address            = 0.0.0.0
port                    = 3306

character-set-server    = utf8mb4
collation-server        = utf8mb4_general_ci

# [mysqld] -> debut de la section concernant le serveur entre crochet 
# user -> user system qui exec mysqld (root dangereux si pirate)
# pid-process -> fichier contenant le pid pour kill et verifier si il tourne bien
# basedir -> dossier installation mariadb (/usr -> emplacement des binaires)
# datadir -> dossier stockage bases de donnees (users, log, base wp, ...)
# tmpdir -> dossier fichier temporaires (operation temp, etc)
# bind ardress -> adresse ecoute 0.0.0.0 = toutes les interfaces(conteneurs internes et meme exernes si port expose dans docker compose(ports)) | 127.0.0.1 = reseau local unoquement | mariadb = reseau bridge interne entre les conteneurs de inception
# port -> port ecoute (wp se connectera dessus)
# character-set-server -> encodage caractere (utf8mb4 = support emoji)
# collation-server -> regle de comparaison/tri (utf8mb4_general_ci = insensible a la casse ex "cafe" = "Café")
